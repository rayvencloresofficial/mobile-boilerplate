PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/boilerplate_db

JWT_SECRET=super-secret-jwt-key-for-development-change-in-production-12345
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-for-development-change-in-prod-67890
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=default-super-secret-encryption-key-32-bytes!