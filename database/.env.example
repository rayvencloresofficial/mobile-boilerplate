# Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/boilerplate_db

# AES-256-GCM Encryption Key (32-byte passphrase or 64-character hex string)
ENCRYPTION_KEY=default-super-secret-encryption-key-32-bytes!
